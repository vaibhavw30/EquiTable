# EquiTable Backend Environment Variables
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must stay
# that way — `scripts/k8s-up.sh` builds the Kubernetes Secret directly from it
# (`kubectl create secret generic --from-env-file`), so a credential added here
# by mistake would be committed. See ADR-028.

# ── Secrets (become the `equitable-secrets` Secret in Kubernetes) ───────────

# MongoDB Atlas
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Google Gemini (LLM extraction + curator ranking)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps / Places API (discovery + geocoding)
GOOGLE_PLACES_API_KEY=your_google_maps_api_key_here

# LangSmith tracing (ADR-015). Optional — tracing is a no-op without it.
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# Jina Reader fallback (ADR-021). Optional — Jina works unauthenticated; a key
# only raises the rate limit.
JINA_API_KEY=your_jina_api_key_here

# ── Non-secret config ───────────────────────────────────────────────────────
#
# In Kubernetes these live in the `equitable-config` ConfigMap
# (k8s/10-configmap.yaml), NOT in the Secret. They are listed here because the
# same variables configure a local `uvicorn` / `python -m agent.refresh` run.
#
# Caveat when using --from-env-file: every key in .env lands in the Secret,
# including these. The Deployment lists `secretRef` after `configMapRef`, so on
# a duplicate key the Secret's value wins. Keep the values consistent, or omit
# these from .env to let the ConfigMap own them.

DATABASE_NAME=equitable

# Refresh-run knobs — see backend_ml/agent/config.py
# REFRESH_MAX_SOURCES=25            # max pantries refreshed per run
# REFRESH_MAX_COST_USD=0.50         # per-run Gemini budget
# REFRESH_FRESHNESS_HOURS=24        # only refresh pantries staler than this

# Scraper fallback chain (ADR-021)
# JINA_ENABLED=true
# FIRECRAWL_FALLBACK_ENABLED=false  # paid; off by default keeps scraping at $0

# Discovery cache TTL in days (optional, default 7)
# DISCOVERY_CACHE_TTL_DAYS=7

# ── Injected by the platform, not set by hand ──────────────────────────────
#
# REFRESH_RUN_ID  The LangGraph thread_id the refresh run checkpoints under.
#                 The Kubernetes CronJob injects the Job name via the downward
#                 API so a crashed run resumes on the same thread (ADR-024).
#                 Leave unset locally: it falls back to a fresh UUID per run,
#                 which is correct for a standalone invocation.
